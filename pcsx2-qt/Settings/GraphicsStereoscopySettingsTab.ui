   <item>
    <widget class="QGroupBox" name="stereoRenderingGroup">
     <property name="title">
      <string>Rendering Fixes</string>
     </property>
     <layout class="QGridLayout" name="stereoRenderingGroupLayout">
      <item row="0" column="0">
       <widget class="QCheckBox" name="stereoProjectionDepth">
        <property name="text">
         <string>Depth Fix: Projection-aware stereo depth</string>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QCheckBox" name="stereoCloseDepthFix">
        <property name="text">
         <string>Depth Fix: God of War, Gun</string>
        </property>
        <property name="toolTip">
         <string>Depth Fix: God of War, Gun</string>
        </property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QCheckBox" name="stereoSkyFix">
        <property name="text">
         <string>Sky Fix: Killzone, Gran Turismo 4</string>
        </property>
        <property name="toolTip">
         <string>Sky Fix: Killzone, Gran Turismo 4</string>
        </property>
       </widget>
      </item>
      <item row="3" column="0">
       <widget class="QCheckBox" name="stereoRequireRtaCorrection">
        <property name="text">
         <string>Shadows Fix 0: Target Alpha Correction (COD)</string>
        </property>
        <property name="toolTip">
         <string>Disable stereo displacement for draws using target alpha correction, such as COD shadows. With the improved packed renderer enabled, render mono draws in both eyes. Works independently of Shadows Fix 1.</string>
        </property>
       </widget>
      </item>
      <item row="4" column="0">
       <widget class="QCheckBox" name="stereoFixStencilShadows1">
        <property name="text">
         <string>Shadows Fix 1: Fix Stencil Shadows (Tekken 5, MGS 3, MK)</string>
        </property>
        <property name="toolTip">
         <string>Disable stereo displacement for stencil shadow passes in Tekken 5, MGS 3, and MK. With the improved packed renderer enabled, render mono draws in both eyes.</string>
        </property>
       </widget>
      </item>
      <item row="5" column="0">
       <widget class="QCheckBox" name="stereoFixStencilShadows2">
        <property name="text">
         <string>Shadows Fix 2: Fix Stencil Shadows (Tekken 4, Onimusha 3, Medal of Honor)</string>
        </property>
        <property name="toolTip">
         <string>Shadows Fix 2: Fix Stencil Shadows (Tekken 4, Onimusha 3, Medal of Honor)</string>
        </property>
       </widget>
      </item>
      <item row="6" column="0">
       <widget class="QCheckBox" name="stereoFixStencilShadows3">
        <property name="text">
         <string>Shadows Fix 3: Fix Stencil Shadows (God of War, Gun)</string>
        </property>
        <property name="toolTip">
         <string>Shadows Fix 3: Fix Stencil Shadows (God of War, Gun)</string>
        </property>
       </widget>
      </item>
      <item row="7" column="0">
       <widget class="QCheckBox" name="stereoFixStencilShadows4">
        <property name="text">
         <string>Shadows Fix 4: Correct Inverted Depth Shadows</string>
        </property>
        <property name="toolTip">
         <string>Correct stereo depth for alpha-only shadows that use inverted 24-bit depth, as in Jak II.</string>
        </property>
       </widget>
      </item>
      <item row="8" column="0">
       <widget class="QCheckBox" name="stereoRejectRegionRect">
        <property name="text">
